# The demo is a static export served by CloudFront. Live search goes to /api/search
# (same-origin), which CloudFront routes to a PRIVATE Lambda via API Gateway (secret-gated).
#
# Local dev override (optional): point directly at an endpoint you can reach.
# NEXT_PUBLIC_SEARCH_ENDPOINT=https://<something>/search
#
# Default when unset: "/api/search" (works on the deployed CloudFront site).
NEXT_PUBLIC_SEARCH_ENDPOINT=
