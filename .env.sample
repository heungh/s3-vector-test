# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values below.  `.env` is git-ignored.
#   cp .env.sample .env
#
# Do NOT put AWS access keys here — use your normal AWS credentials
# (aws configure / SSO / environment). Account ID, ARNs, and endpoints are
# discovered automatically at deploy time; nothing sensitive is hard-coded.
# ------------------------------------------------------------------------------

# AWS region to deploy into (must have Bedrock + Cohere Embed v4 + S3 Vectors available)
AWS_REGION=us-east-1

# Prefix used for all resource names (bucket, domain, lambda, stack, ...)
PROJECT_NAME=s3-vector-demo

# CloudFormation stack name (defaults to PROJECT_NAME if omitted)
# STACK_NAME=s3-vector-demo

# --- Embedding model (Amazon Bedrock) ---
EMBED_MODEL_ID=cohere.embed-v4:0
EMBED_DIM=1024

# --- Vector stores ---
VECTOR_INDEX=image-embeddings
OPENSEARCH_INDEX=images-hot

# OpenSearch managed domain instance type.
#   r6g.large.search  -> memory-optimized, best for k-NN (recommended, ~$120/mo)
#   m6g.large.search  -> general purpose, cheaper (~$95/mo)
#   t3.small.search   -> cheapest, dev only, slow (~$26/mo)
OPENSEARCH_INSTANCE_TYPE=r6g.large.search

# --- Ingestion sizing (sample dataset ships in ingestion/sample_data) ---
INGEST_LIMIT=300     # images embedded into S3 Vectors (full catalog)
HOT_LIMIT=150        # subset mirrored into OpenSearch (hot tier)
# DATA_DIR=/absolute/path/to/your/jsonl/dir   # optional: use your own dataset

# --- Security ---
# Shared secret that CloudFront injects and the Lambda verifies (gate for API Gateway).
# Leave BLANK to auto-generate a random secret on first deploy (recommended).
ORIGIN_SECRET=
